
# CricZone Backend Environment Configuration

# Application
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=

# Redis
REDIS_URL=

# Kafka
KAFKA_CLIENT_ID=criczone
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_PATH=
KAFKA_LIVE_CONSUMER_GROUP=criczone-live-consumer
KAFKA_DLQ_TOPIC=criczone.live-events.dlq

CORS_ALLOWED_ORIGINS = "http://localhost:5173"

DB_POOL_MAX = 10
DB_IDLE_TIMEOUT_MS = 30000
DB_CONNECTION_TIMEOUT_MS = 5000
DB_STATEMENT_TIMEOUT_MS = 10000